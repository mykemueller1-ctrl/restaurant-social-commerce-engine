{
  "name": "restaurant-social-commerce-engine",
  "private": true,
  "version": "0.1.0",
  "description": "Industry-grade social commerce engine for restaurants: TikTok Shop in-feed buy buttons, Instagram Order Food, Grok Bot scout handoff.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @rsc/db generate",
    "db:migrate": "pnpm --filter @rsc/db migrate",
    "db:push": "pnpm --filter @rsc/db push",
    "db:seed": "pnpm --filter @rsc/db seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3"
 },
  "engines": { "node": ">=20" }
}
