{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@rsc/db": ["packages/db/src"],
      "@rsc/tiktok": ["packages/tiktok-shop/src"],
      "@rsc/instagram": ["packages/instagram/src"],
      "@rsc/config": ["packages/config/src"]
    }
  }
}
