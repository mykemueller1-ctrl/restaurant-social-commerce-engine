# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# packages/db (Postgres)
DATABASE_URL="postgresql://localhost:5432/restaurant_commerce?schema=public"

# TikTok Shop Partner Center app credentials (sandbox first)
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_SHOP_CIPHER=
TIKTOK_SHOP_API_BASE_URL=https://open-api-sandbox.tiktokglobalshop.com
TIKTOK_SHOP_WEBHOOK_SECRET=

# Meta / Instagram Graph API
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v19.0
META_PAGE_ACCESS_TOKEN=

# Stripe (direct checkout fallback only; TikTok handles in-app checkout)
STRIPE_SECRET_KEY=

# Observability
SENTRY_DSN=

# apps/web
API_BASE_URL=http://localhost:4000

# Grok Bot handoff (see grok-bot/)
GROK_BOT_API_TOKEN=
