    "@restaurant/config": "workspace:*",
    "@restaurant/db": "workspace:*",
    "@restaurant/tiktok-shop": "workspace:*",
    "fastify": "^4.28.1",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
